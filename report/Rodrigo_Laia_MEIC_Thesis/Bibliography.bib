@article{Cyrino_2001, title={Algumas diferenças entre o Português brasileiro e o português europeu e sua relação com a mudança sintática no português brasileiro}, volume={4}, url={https://ojs.uel.br/revistas/uel/index.php/signum/article/view/4366}, DOI={10.5433/2237-4876.2001v4n1p95}, abstractNote={&amp;lt;span style=&amp;quot;font-family: Verdana, sans-serif; font-size: small;&amp;quot;&amp;gt;&amp;lt;span style=&amp;quot;font-size: 11px; line-height: 16px;&amp;quot;&amp;gt;&amp;lt;span style=&amp;quot;font-size: 8.0pt; line-height: 150%; font-family: &amp;quot;&amp;gt;Este trabalho tem o objetivo de apresentar algumas diferenças entre o português brasileiro (PB) e o português europeu (PE) atuais e questionar como elas podem ser detectadas e servir de base para uma investigação sobre a história do PB. Embora esse tipo de análise não tenha ainda merecido muitos estudos, esse tipo de pesquisa é importante na medida em que o PB pode apresentar diferenças em relação ao PE atual como conseqüências de mudanças que tenham ocorrido em seu percurso diacrônico. Primeiramente apresenta as diferenças encontradas entre o PE e o PB acerca do objeto nulo e, em seguida, acerca da elipse de VP. Através da observação desses fenômenos, considera-se algumas hipóteses sobre a mudança diacrônica que pode estar relacionada, ou seja, a mudança na estrutura verbal do PB. &amp;lt;/span&amp;gt;&amp;lt;/span&amp;gt;&amp;lt;/span&amp;gt;}, number={1}, journal={Signum: Estudos da Linguagem}, author={Cyrino, Sonia Maria Lazzarini}, year={2001}, month={jul.}, pages={95–112} }

